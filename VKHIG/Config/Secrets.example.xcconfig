// Copy to Secrets.xcconfig (gitignored) and fill before device/TestFlight testing.
// Do NOT commit real client secrets. Public client id may live here for debug builds.

VK_CLIENT_ID = YOUR_VK_ID_CLIENT_ID
VK_REDIRECT_SCHEME = vkhig
VK_API_VERSION = 5.199

// Optional: wire into target INFOPLIST_KEY / OTHER_SWIFT_FLAGS later.
// Example Info.plist keys mirrored by AppSecrets:
//   VK_CLIENT_ID, VK_REDIRECT_SCHEME, VK_API_VERSION
