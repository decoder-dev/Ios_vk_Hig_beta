// Copy to Secrets.xcconfig (gitignored) for local Mac builds.
// Or rely on GitHub Actions secrets: VK_ID_CLIENT_ID / VK_ID_CLIENT_SECRET
//
// VK ID public/PKCE client: only VK_CLIENT_ID belongs in the app Info.plist.
// VK_CLIENT_SECRET / VK_ID_CLIENT_SECRET must NOT be embedded in the iOS binary —
// use for confidential server-side token exchange only.

VK_CLIENT_ID = YOUR_VK_ID_CLIENT_ID
VK_ID_CLIENT_ID = YOUR_VK_ID_CLIENT_ID
VK_REDIRECT_SCHEME = vk$(VK_CLIENT_ID)
VK_REDIRECT_HOST = vk.com
VK_REDIRECT_PATH = /blank.html
VK_API_VERSION = 5.199
VK_CLIENT_SECRET = YOUR_VK_ID_CLIENT_SECRET
VK_ID_CLIENT_SECRET = YOUR_VK_ID_CLIENT_SECRET
