// Committed defaults. Local overrides via optional Secrets.xcconfig (gitignored).
// GitHub Actions secret names (repo Settings → Secrets):
//   VK_ID_CLIENT_ID
//   VK_ID_CLIENT_SECRET   ← CI/backend only; never inject into the iOS binary

VK_CLIENT_ID = 54879294
// VK ID accepts vk<client id>://vk.com/blank.html for iOS apps without extra cabinet setup.
// (https://com.decoderdev.vkhig and vkhig://vkid were rejected as invalid redirect_uri.)
VK_REDIRECT_SCHEME = vk$(VK_CLIENT_ID)
VK_REDIRECT_HOST = vk.com
VK_REDIRECT_PATH = /blank.html
VK_API_VERSION = 5.199
VK_REQUESTED_SCOPES = vkid.personal_info

#include? "Secrets.xcconfig"
