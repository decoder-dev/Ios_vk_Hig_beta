// Committed defaults. Local overrides via optional Secrets.xcconfig (gitignored).
// GitHub Actions secret names (repo Settings → Secrets):
//   VK_ID_CLIENT_ID
//   VK_ID_CLIENT_SECRET   ← CI/backend only; never inject into the iOS binary

VK_CLIENT_ID = 54707652
VK_REDIRECT_SCHEME = vkhig
VK_API_VERSION = 5.199
VK_REQUESTED_SCOPES = vkid.personal_info

#include? "Secrets.xcconfig"

CODE_SIGN_ENTITLEMENTS = VKHIG/Resources/VKHIG.entitlements
APNS_ENVIRONMENT = development
APNS_ENVIRONMENT[config=Release] = production
