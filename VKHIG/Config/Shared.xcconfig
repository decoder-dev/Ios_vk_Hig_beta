VK_REDIRECT_SCHEME = https
VK_REDIRECT_HOST = com.decoderdev.vkhig
VK_API_VERSION = 5.199
VK_REQUESTED_SCOPES = vkid.personal_info

#include? "Secrets.xcconfig"
